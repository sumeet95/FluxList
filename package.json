{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "postinstall": "node generate-icon.cjs",
    "expo:start": "node generate-icon.cjs && expo start",
    "android": "node generate-icon.cjs && expo start --android",
    "ios": "node generate-icon.cjs && expo start --ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "^56.0.13",
    "@google/genai": "^2.4.0",
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "expo": "^56.0.4",
    "expo-asset": "^56.0.15",
    "expo-file-system": "^56.0.7",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-native-web": "^0.21.2",
    "vite": "^6.2.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "react-native": "^0.85.3",
    "react-native-webview": "^13.16.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
